      "typeVersion": 4.5,
      "position": [240, 0],
      "id": "bb222222-2222-2222-2222-222222222222",
      "name": "Get Bot Leads",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = Date.now();\nconst oneHourMs = 60 * 60 * 1000;\n\nconst qualifying = items.filter(item => {\n  const ts = new Date(item.json['Timestamp']).getTime();\n  const status = (item.json['Status'] || '').trim();\n\n  return (\n    !isNaN(ts) &&\n    (now - ts) >= oneHourMs &&\n    status === 'New'\n  );\n});\n\nif (qualifying.length === 0) {\n  return [{ json: { hasLeads: false } }];\n}\n\nreturn qualifying.map(item => ({ json: { ...item.json, hasLeads: true } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0],
      "id": "cc333333-3333-3333-3333-333333333333",
      "name": "Filter Qualifying Leads"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-001",
              "leftValue": "={{ $json.hasLeads }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [720, 0],
      "id": "dd444444-4444-4444-4444-444444444444",
      "name": "Has Leads to Follow Up?"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [960, -80],
      "id": "ee555555-5555-5555-5555-555555555555",
      "name": "Process One Lead at a Time"
    },
    {
      "parameters": {
        "jsCode": "const productInterest = ($json['Product Interest'] || 'our laptop bags').trim();\nconst senderId = $json['Sender ID'];\n\nconst message = [\n  `Hi! Just checking in — were you still interested in ${productInterest}? We'd love to help you find the perfect one! 😊`,\n  `Hi po! Nandito pa kami kung gusto ninyong ituloy. Huwag mahiyang magtanong tungkol sa ${productInterest}! 😊`\n].join('\\n\\n');\n\nreturn [{\n  json: {\n    ...($json),\n    followUpMessage: message,\n    recipientId: senderId\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, -80],
      "id": "ff666666-6666-6666-6666-666666666666",
      "name": "Build Follow-up Message"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v25.0/me/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer REPLACE_WITH_YOUR_PAGE_ACCESS_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ recipient: { id: $json.recipientId }, message: { text: $json.followUpMessage } }) }}",
        "options": {
          "retry": {
            "enabled": true,
            "maxRetries": 2,
            "retryInterval": 1000
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, -80],
      "id": "aa777777-7777-7777-7777-777777777777",
