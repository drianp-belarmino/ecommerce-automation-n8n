      "position": [0, 0],
      "id": "aa111111-1111-1111-1111-111111111111",
      "name": "Every 15 Minutes"
    },
    {
      "parameters": {
        "operation": "getAll",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_BOT_LEADS_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
