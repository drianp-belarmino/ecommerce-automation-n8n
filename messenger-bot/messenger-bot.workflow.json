    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\n\nif (!staticData.seenMessages) {\n  staticData.seenMessages = {};\n}\n\nconst messageId = $input.first().json.body.entry[0].messaging[0].message.mid;\nconst now = Date.now();\n\nfor (const id in staticData.seenMessages) {\n  if (now - staticData.seenMessages[id] > 300000) {\n    delete staticData.seenMessages[id];\n  }\n}\n\nif (staticData.seenMessages[messageId]) {\n  return [];\n}\n\nstaticData.seenMessages[messageId] = now;\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-288, -352],
      "id": "966b302f-90b1-4fc4-987a-6ed14cb44b1a",
      "name": "Deduplicate Messages"
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\n\nif (!staticData.rateLimits) {\n  staticData.rateLimits = {};\n}\n\nconst senderId = $input.first().json.body.entry[0].messaging[0].sender.id;\nconst now = Date.now();\nconst windowMs = 300000;\nconst maxMessages = 10;\n\nif (!staticData.rateLimits[senderId]) {\n  staticData.rateLimits[senderId] = [];\n}\n\nstaticData.rateLimits[senderId] = staticData.rateLimits[senderId].filter(\n  ts => now - ts < windowMs\n);\n\nif (staticData.rateLimits[senderId].length >= maxMessages) {\n  return [];\n}\n\nstaticData.rateLimits[senderId].push(now);\nreturn $input.all();"
      },
