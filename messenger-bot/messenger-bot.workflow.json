        "jsCode": "const message = $('Has Text Message?').item.json.body.entry[0].messaging[0].message.text.toLowerCase();\n\nconst buyingKeywords = [\n  'order', 'bili', 'how to buy', 'paano mag order', 'how to order',\n  'paano umorder', 'umorder', 'how to purchase',\n  'how to checkout', 'paano mag checkout', 'checkout', 'check out',\n  'magkano', 'how much', 'price', 'presyo',\n  'available', 'meron pa', 'in stock',\n  'i want', 'gusto ko'\n];\n\nconst isBuyingIntent = buyingKeywords.some(keyword => message.includes(keyword));\n\nreturn [{\n  json: {\n    ...$json,\n    isBuyingIntent: isBuyingIntent,\n    senderID: $('Has Text Message?').item.json.body.entry[0].messaging[0].sender.id,\n    customerMessage: $('Has Text Message?').item.json.body.entry[0].messaging[0].message.text,\n    aiResponse: $json.output\n  }\n}];"
